pipeline {
    agent any

    environment {
        JAVA_HOME        = '/usr/lib/jvm/java-21-openjdk-amd64'
        PATH             = "/usr/lib/jvm/java-21-openjdk-amd64/bin:${env.PATH}"
        SERVICE_NAME     = 'publication-service'
        DOCKER_NAMESPACE = 'yesmine111'
        IMAGE_NAME       = "${DOCKER_NAMESPACE}/${SERVICE_NAME}"
        APP_PORT         = '8082'
        K8S_NAMESPACE    = 'devops'
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('📥 Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: '*/devops/on-integrated6sur6/ads_cicd_k8s']],
                    extensions: [[$class: 'CloneOption', depth: 1, shallow: true]],
                    userRemoteConfigs: [[
                        credentialsId: 'github-credentials',
                        url: 'https://github.com/farrahamami/ESPRIT-PIDEV-4SAE4-2025-2026-Prolance-BACKEND'
                    ]]
                ])
            }
        }

        stage('🔖 Récupérer le tag CI') {
            steps {
                script {
                    def tagFile = '/var/lib/jenkins/jobs/publication-service-ci/builds/lastSuccessfulBuild/archive/last-build.txt'
                    try {
                        env.IMAGE_TAG = sh(script: "cat ${tagFile}", returnStdout: true).trim()
                    } catch (e) {
                        env.IMAGE_TAG = 'latest'
                    }
                    echo "🔖 Tag récupéré : ${env.IMAGE_TAG}"
                }
            }
        }

        stage('🔭 Déployer Jaeger') {
            steps {
                dir('publication-service/k8s') {
                    sh '''
                        echo "🔭 Déploiement de Jaeger dans Kubernetes..."
                        kubectl apply -f jaeger-deployment.yaml --validate=false -n ${K8S_NAMESPACE}

                        echo "⏳ Attente que Jaeger soit prêt..."
                        kubectl rollout status deployment/jaeger -n ${K8S_NAMESPACE} --timeout=120s

                        echo "✅ Jaeger déployé."
                        kubectl get pods -l app=jaeger -n ${K8S_NAMESPACE}
                    '''
                }
            }
        }

        stage('🚀 Deploy to Kubernetes') {
            steps {
                dir('publication-service/k8s') {
                    sh '''
                        sed -i "s|IMAGE_PLACEHOLDER|${IMAGE_NAME}:${IMAGE_TAG}|g" deployment.yaml
                        kubectl apply -f deployment.yaml --validate=false
                        kubectl apply -f service.yaml --validate=false
                    '''
                }
            }
        }

        stage('✅ Vérifier le déploiement') {
            steps {
                sh '''
                    kubectl rollout status deployment/${SERVICE_NAME} -n ${K8S_NAMESPACE} --timeout=120s
                    kubectl get pods -l app=${SERVICE_NAME} -n ${K8S_NAMESPACE}
                '''
            }
        }

        stage('📡 Vérifier les traces Jaeger') {
            steps {
                sh '''
                    echo "📡 Vérification des traces dans Jaeger..."
                    sleep 15

                    NODE_IP=$(kubectl get nodes -o jsonpath="{.items[0].status.addresses[0].address}")
                    JAEGER_URL="http://${NODE_IP}:30686"

                    echo "🔗 Jaeger UI : ${JAEGER_URL}"

                    curl -sf "${JAEGER_URL}/api/services" > /dev/null \
                        && echo "✅ Jaeger API accessible" \
                        || echo "⚠️  Jaeger API pas encore prête (normal au premier démarrage)"

                    curl -sf "${JAEGER_URL}/api/services" 2>/dev/null \
                        | python3 -c "import sys,json; d=json.load(sys.stdin); print('Services tracés:', d.get('data', []))" \
                        || true
                '''
            }
        }
    }

    post {
        success {
            echo "✅ CD OK : ${SERVICE_NAME} déployé avec Jaeger actif. UI : http://NODE_IP:30686"
        }
        failure {
            sh '''
                echo "❌ Diagnostic :"
                kubectl get pvc -n ${K8S_NAMESPACE} 2>/dev/null || true
                kubectl get pv 2>/dev/null || true
                kubectl get pods -n ${K8S_NAMESPACE} 2>/dev/null || true
                kubectl describe pods -n ${K8S_NAMESPACE} -l app=publication-service 2>/dev/null | tail -40 || true
                kubectl logs -n ${K8S_NAMESPACE} -l app=publication-service --tail=50 2>/dev/null || true
            '''
            echo "❌ CD échoué pour ${SERVICE_NAME}."
        }
        always {
            cleanWs()
        }
    }
}